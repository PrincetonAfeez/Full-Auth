FULL_AUTH_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_COOKIES=false
# Only enable when actually deployed behind a TLS-terminating proxy.
DJANGO_TRUST_PROXY_SSL_HEADER=false
DATABASE_URL=postgresql://fullauth:fullauth@postgres:5432/fullauth
REDIS_URL=redis://redis:6379/0
TOTP_ENCRYPTION_KEY=
AWAITING_2FA_TTL_MINUTES=5
AWAITING_2FA_MAX_ATTEMPTS=5
THROTTLE_FAIL_CLOSED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Full Auth
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
METRICS_TOKEN=
ALERT_WEBHOOK_TOKEN=
